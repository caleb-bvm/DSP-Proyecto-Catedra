@model ErrorViewModel
@{ ViewData["Title"] = "No se pudo completar la operación"; }
<div class="panel">
    <h1>No se pudo completar la operación</h1>
    <p>Inténtalo nuevamente. Si el problema continúa, informa al administrador.</p>
    @if (Model.ShowRequestId) { <p>Referencia: <code>@Model.RequestId</code></p> }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
